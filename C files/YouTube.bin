input { background-color: transparent; padding-bottom: 4px; outline: none; box-sizing: border-box; border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(115, 115, 115); border-image: initial; border-radius: 0px; margin-bottom: 1px; font: inherit; color: var(--tffc2fd3a644f6275); text-overflow: ellipsis; }

input:focus { margin-bottom: 0px; border-bottom-width: 2px; border-bottom-color: var(--tffc2fd3a644f6275); }


  .fullscreen-controls-always-on .player-controls-bottom.player-controls-bottom-right { left: unset; right: 0px; z-index: 4; }
  .fullscreen-controls-always-on .player-controls-bottom.player-controls-bottom-right.player-controls-bottom-mirror-rtl { left: unset; right: 0px; }
  .fullscreen-controls-always-on .fullscreen-action-menu { left: 2px; right: 2px; bottom: 2px; }

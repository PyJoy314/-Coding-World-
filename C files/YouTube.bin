@media (max-width: 839.9px) {
  .ytSnackbarContainerMobile { width: 100%; }
}

.ytSnackbarContainerOpened { animation: 0.5s ease 0s 1 normal forwards running snackbar-slide-in-from-bottom; }

.ytSnackbarContainerClosed { animation: 0.5s ease 0s 1 normal forwards running snackbar-slide-out-to-bottom; }

@-webkit-keyframes snackbar-slide-in-from-bottom { 
  0% { transform: translateY(100%); opacity: 0; }
  100% { transform: translateY(0px); opacity: 1; }
}

@keyframes snackbar-slide-in-from-bottom { 
  0% { transform: translateY(100%); opacity: 0; }
  100% { transform: translateY(0px); opacity: 1; }
}

@-webkit-keyframes snackbar-slide-out-to-bottom { 
  0% { transform: translateY(0px); opacity: 1; }
  100% { transform: translateY(100%); opacity: 0; }
}

@keyframes snackbar-slide-out-to-bottom { 
  0% { transform: translateY(0px); opacity: 1; }
  100% { transform: translateY(100%); opacity: 0; }
}

.ytEphemeralActionsHost { position: absolute; top: -9999px; left: -9999px; height: 1px; overflow: hidden; }

.ytInlinePlayerControlsHost { direction: ltr; position: absolute; pointer-events: none; inset: 0px; container-type: size; }

.ytInlinePlayerControlsControlsContainer { width: 0px; height: 0px; pointer-events: auto; }


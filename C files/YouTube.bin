.ytSnackbarContainerHost { bottom: 0px; position: fixed; z-index: 2202; }

.ytSnackbarContainerSnackbarContainer { bottom: 30px; position: fixed; outline: none; box-sizing: border-box; max-width: 448px; min-width: 288px; min-height: 48px; max-height: 64px; }


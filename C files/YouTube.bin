input::placeholder { color: var(--t4a6da19e16bf221a); opacity: 1; }

textarea { background-color: transparent; outline: none; box-sizing: border-box; border-radius: 0px; margin-bottom: 1px; font: inherit; color: var(--tffc2fd3a644f6275); appearance: none; min-height: 8.4rem; width: 100%; border: 1px solid var(--tf3fc855af2285f5f); padding: 8px; }

textarea::-webkit-input-placeholder { color: var(--t4a6da19e16bf221a); opacity: 1; }

textarea::placeholder { color: var(--t4a6da19e16bf221a); opacity: 1; }

form { margin: 0px; }

a { color: currentcolor; text-decoration: none; }

h1 { display: -webkit-box; -webkit-box-orient: vertical; max-height: 2.5em; -webkit-line-clamp: 2; overflow: hidden; line-height: 1.25; text-overflow: ellipsis; font-weight: 400; margin: 0px; }

h2 { display: -webkit-box; -webkit-box-orient: vertical; max-height: 2.5em; -webkit-line-clamp: 2; overflow: hidden; line-height: 1.25; text-overflow: ellipsis; font-weight: 400; margin: 0px; font-size: 1.8rem; }

h3 { display: -webkit-box; -webkit-box-orient: vertical; max-height: 2.5em; -webkit-line-clamp: 2; overflow: hidden; line-height: 1.25; text-overflow: ellipsis; font-weight: 400; margin: 0px; font-size: 1.4rem; }

h4 { display: -webkit-box; -webkit-box-orient: vertical; max-height: 2.5em; -webkit-line-clamp: 2; overflow: hidden; line-height: 1.25; text-overflow: ellipsis; font-weight: 400; margin: 0px; font-size: 1.3rem; }

img { min-width: 1px; min-height: 1px; filter: none; }

img:not([src]) { visibility: hidden; }

:focus { outline: none; }

.title { -webkit-box-flex: 1; flex-grow: 1; margin: 0px; font-size: 1.5rem; font-weight: 400; }


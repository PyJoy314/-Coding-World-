@-webkit-keyframes flip-to-back { 
  0% { transform: rotateX(0deg) scale(1) rotateY(0deg); animation-timing-function: cubic-bezier(0.5, 0, 0.8, 1); }
  50% { transform: rotateX(90deg) scale(1.2) rotateY(5deg); animation-timing-function: cubic-bezier(0.2, 0, 0.5, 1); }
  100% { transform: rotateX(180deg) scale(1) rotateY(0deg); }
}

@keyframes flip-to-back { 
  0% { transform: rotateX(0deg) scale(1) rotateY(0deg); animation-timing-function: cubic-bezier(0.5, 0, 0.8, 1); }
  50% { transform: rotateX(90deg) scale(1.2) rotateY(5deg); animation-timing-function: cubic-bezier(0.2, 0, 0.5, 1); }
  100% { transform: rotateX(180deg) scale(1) rotateY(0deg); }
}

@-webkit-keyframes flip-to-front { 
  0% { transform: rotateX(180deg) scale(1) rotateY(0deg); animation-timing-function: cubic-bezier(0.5, 0, 0.8, 1); }
  50% { transform: rotateX(90deg) scale(1.2) rotateY(-5deg); animation-timing-function: cubic-bezier(0.2, 0, 0.5, 1); }
  100% { transform: rotateX(0deg) scale(1) rotateY(0deg); }
}

@keyframes flip-to-front { 
  0% { transform: rotateX(180deg) scale(1) rotateY(0deg); animation-timing-function: cubic-bezier(0.5, 0, 0.8, 1); }
  50% { transform: rotateX(90deg) scale(1.2) rotateY(-5deg); animation-timing-function: cubic-bezier(0.2, 0, 0.5, 1); }
  100% { transform: rotateX(0deg) scale(1) rotateY(0deg); }
}


.content-error { font-size: 1.4rem; padding: 12px; text-align: center; }

#player-thumbnail-overlay { position: absolute; top: 0px; object-fit: cover; min-height: 0px; }

#player-container-id[playable="true"] #player-thumbnail-overlay { visibility: hidden; }

body.page-shorts, html[page-shorts] { overscroll-behavior-y: none; }

body.loading.page-shorts #header, body.loading.page-shorts .player-placeholder-wrapper { display: none; }

body.page-shorts #player-container-id, body.page-shorts .player-container #player { height: 100%; top: 0px; }

* { }

html { overflow-wrap: break-word; color: var(--tffc2fd3a644f6275); background-color: var(--t3e41d7b17b187f69); text-size-adjust: 100%; }


.ytInlinePlayerControlsDarkenedOverlayShow { opacity: 1; }

.ytInlinePlayerControlsControlsHidden { visibility: hidden; }

.ytInlinePlayerControlsTopLeftControls { position: absolute; top: 0px; left: 0px; }

[dir="rtl"] .ytInlinePlayerControlsTopLeftControls { direction: rtl; }

.ytInlinePlayerControlsBottomLeftControls { position: absolute; bottom: 0px; left: 0px; }

[dir="rtl"] .ytInlinePlayerControlsBottomLeftControls { direction: rtl; }

.ytInlinePlayerControlsTopRightControls { --inline-player-button-animation: dim-controls 700ms ease 2000ms forwards; position: absolute; top: 0px; right: 0px; margin: 8px; }

.ytInlinePlayerControlsTopRightControls:active { --inline-player-button-animation: undim-controls 1s infinite; }

@media not all and (hover: none) {
  .ytInlinePlayerControlsTopRightControls:hover { --inline-player-button-animation: undim-controls 1s infinite; }
}

.ytInlinePlayerControlsTopRightControlsCircleButton { position: relative; color: rgb(255, 255, 255); background: rgba(0, 0, 0, 0.6); animation: var(--inline-player-button-animation); border-radius: 50%; width: 40px; height: 40px; margin-bottom: 8px; }

@container (max-height: 150px) {

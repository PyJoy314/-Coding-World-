.ytMiniAppScoreChallengeViewModelHost { padding: 24px 24px 8px; width: auto; display: block; }

.ytMiniAppScoreChallengeViewModelScoreRadial { display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; width: 100%; height: 148px; position: relative; }

.ytMiniAppScoreChallengeViewModelScoreRadial::before { content: ""; position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; transform-origin: center center; border-radius: 31px; mask-image: radial-gradient(rgb(0, 0, 0) 20%, transparent 60%); filter: blur(2px); background: repeating-conic-gradient(rgb(247, 215, 197) 0deg, rgb(247, 215, 197) 10deg, transparent 10deg, transparent 20deg); }

.ytMiniAppScoreChallengeViewModelDarkScoreRadial::before { background: repeating-conic-gradient(rgb(66, 79, 93) 0deg, rgb(66, 79, 93) 10deg, transparent 10deg, transparent 20deg); }

.ytMiniAppScoreChallengeViewModelTitle { color: var(--tffc2fd3a644f6275); text-align: center; font-family: Roboto, Arial, sans-serif; font-size: 2rem; line-height: 2.8rem; font-weight: 700; overflow: hidden; max-height: 5.6rem; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; text-overflow: ellipsis; white-space: normal; }

.ytMiniAppScoreChallengeViewModelSubtitle { color: var(--t4a6da19e16bf221a); padding: 8px 0px; text-align: center; font-family: Roboto, Arial, sans-serif; font-size: 1.4rem; line-height: 2rem; font-weight: 400; overflow: hidden; max-height: 2rem; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; text-overflow: ellipsis; white-space: normal; }

.ytMiniAppScoreChallengeViewModelScore { color: var(--tffc2fd3a644f6275); min-width: 82px; padding: 0px 16px; height: 62px; border-radius: 31px; background-color: var(--t518e925f61bdcb91); display: grid; -webkit-box-align: center; align-items: center; text-align: center; position: relative; font-family: Roboto, Arial, sans-serif; font-size: 3.2rem; line-height: 4.4rem; font-weight: 900; }

.ytMiniAppScoreChallengeViewModelPrompt { color: var(--t4a6da19e16bf221a); padding-top: 8px; text-wrap: wrap; text-align: center; font-family: Roboto, Arial, sans-serif; font-size: 1.4rem; line-height: 2rem; font-weight: 400; }

.miniAppSplashScreenViewModelHost { display: block; height: 100%; width: 100%; }

.miniAppSplashScreenViewModelLoadingScreen { height: 100%; overflow: hidden; position: relative; display: flex; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; }

.miniAppSplashScreenViewModelBackgroundBase { background-color: rgb(0, 0, 0); position: absolute; inset: 0px; }

.miniAppSplashScreenViewModelBackgroundBlur { background-size: 120% 150%; filter: blur(200px); height: 100%; width: 100%; position: absolute; inset: 0px; }

.miniAppSplashScreenViewModelBackgroundScrim { background-color: rgba(0, 0, 0, 0.6); position: absolute; inset: 0px; }

.miniAppSplashScreenViewModelLoadingScreenContent { position: absolute; inset: 0px; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; }

.miniAppSplashScreenViewModelTimeoutMessageContainer { box-sizing: border-box; color: rgb(255, 255, 255); padding: 0px 24px 24px; text-align: center; width: 100%; align-self: flex-end; font-family: Roboto, Arial, sans-serif; font-size: 1.4rem; line-height: 2rem; font-weight: 400; }

.miniAppSplashScreenViewModelTimeoutHeading { font-family: Roboto, Arial, sans-serif; font-size: 2rem; line-height: 2.8rem; font-weight: 700; margin-bottom: 6px; }

@media (max-width: 527.9px) {
  .miniAppSplashScreenViewModelTimeoutHeading { font-family: Roboto, Arial, sans-serif; font-size: 1.8rem; line-height: 2.6rem; font-weight: 700; }
}

@-webkit-keyframes message-fade-in { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes message-fade-in { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.miniAppSplashScreenViewModelTimeoutMessage { animation: 2s cubic-bezier(0.05, 0, 0, 1) 0s 1 normal none running message-fade-in; display: -webkit-box; overflow: hidden; opacity: 1; -webkit-line-clamp: 2; -webkit-box-orient: vertical; transition: opacity 0.4s cubic-bezier(0.05, 0, 0, 1); }

.miniAppSplashScreenViewModelTimeoutMessageFadeOut { opacity: 0; transition: opacity 0.4s cubic-bezier(0.05, 0, 0, 1); }

.miniAppSplashScreenViewModelLoadingBarTrack { background-color: rgba(255, 255, 255, 0.3); border-radius: 4px; height: 4px; margin: 16px auto 0px; max-width: 400px; overflow: hidden; width: 100%; }

.miniAppSplashScreenViewModelLoadingBarSegment { background-color: rgb(255, 255, 255); border-radius: 4px; height: 100%; transform: scaleX(0); transform-origin: left top; width: 100%; }

.miniAppSplashScreenViewModelLoadingBarSegmentResourceAnimation { transition: transform 0.25s cubic-bezier(0.2, 0, 0.6, 1), -webkit-transform 0.25s cubic-bezier(0.2, 0, 0.6, 1); }

.miniAppSplashScreenViewModelLoadingBarSegmentLatencyMoodAnimation { transition: transform 14s cubic-bezier(0.2, 0, 0.6, 1), -webkit-transform 14s cubic-bezier(0.2, 0, 0.6, 1); }

.miniAppSplashScreenViewModelLoadingBarSegmentLatencyMotionAnimation { transition: transform 14s cubic-bezier(0.05, 0, 0, 1), -webkit-transform 14s cubic-bezier(0.05, 0, 0, 1); }


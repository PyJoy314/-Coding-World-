.ytPlayerControlsAnimatedSeekArrowsArrowSmallForward { border-left: 5px solid rgb(255, 255, 255); margin-right: -2.5px; animation-name: forward-arrow-fade; }

.ytPlayerControlsAnimatedSeekArrowsArrowSmallBackward { border-right: 5px solid rgb(255, 255, 255); margin-left: -2.5px; animation-name: backward-arrow-fade; }

.ytPlayerControlsAnimatedSeekArrowsArrowLarge { width: 20px; height: 20px; border: 10px solid rgba(0, 0, 0, 0); }


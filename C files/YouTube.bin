@-webkit-keyframes forward-arrow-fade { 
  0% { border-left-color: rgba(0, 0, 0, 0); }
  50% { border-left-color: rgb(255, 255, 255); }
  100% { border-left-color: rgba(0, 0, 0, 0); }
}

@keyframes forward-arrow-fade { 
  0% { border-left-color: rgba(0, 0, 0, 0); }
  50% { border-left-color: rgb(255, 255, 255); }
  100% { border-left-color: rgba(0, 0, 0, 0); }
}

@-webkit-keyframes backward-arrow-fade { 
  0% { border-right-color: rgba(0, 0, 0, 0); }
  50% { border-right-color: rgb(255, 255, 255); }
  100% { border-right-color: rgba(0, 0, 0, 0); }
}


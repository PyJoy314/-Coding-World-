}

.ytInlinePlayerControlsButtonIcon { position: absolute; top: 50%; left: 49%; transform: translate(-50%, -50%); filter: drop-shadow(rgba(0, 0, 0, 0.6) 0px 1px 2px); }

.ytInlinePlayerControlsBottomRightControls { position: absolute; bottom: 0px; right: 0px; display: flex; -webkit-box-orient: horizontal; -webkit-box-direction: normal; flex-direction: row; -webkit-box-align: end; align-items: flex-end; pointer-events: none; transition: opacity 0.1s cubic-bezier(0.2, 0, 0.6, 1); }

[dir="rtl"] .ytInlinePlayerControlsBottomRightControls { direction: rtl; }

.ytInlinePlayerControlsBottomRightControlsHidden { opacity: 0; }

.ytInlinePlayerControlsTimeDisplay { margin: 8px; }

.ytInlinePlayerControlsLiveBadge { text-transform: uppercase; }

.ytInlinePlayerControlsLiveBadgeDisplay { margin: 8px; }

@-webkit-keyframes dim-controls { 
  0% { background: rgba(0, 0, 0, 0.6); }
  100% { background: none; }
}

@keyframes dim-controls { 
  0% { background: rgba(0, 0, 0, 0.6); }
  100% { background: none; }
}

@-webkit-keyframes undim-controls { 
  0% { background: rgba(0, 0, 0, 0.6); }
  100% { background: rgba(0, 0, 0, 0.6); }
}

@keyframes undim-controls { 
  0% { background: rgba(0, 0, 0, 0.6); }
  100% { background: rgba(0, 0, 0, 0.6); }
}

